# ---------------------------------------------------------------------------
# Backuper bootstrap settings. Everything else (sources, credentials, schedule,
# archive location, zip password, ...) is managed from the Telegram admin panel
# and stored encrypted in DATA_DIR/backuper.db.
# ---------------------------------------------------------------------------

# From @BotFather
BOT_TOKEN=

# From https://my.telegram.org -> API development tools. Required: uploads go
# over MTProto, which allows 2 GB per file instead of the Bot API's 50 MB.
API_ID=
API_HASH=

# Comma-separated Telegram user IDs that are always admins (get yours from
# @userinfobot, or send /id to the bot). More admins can be added in the bot.
OWNER_IDS=

# Encrypts every stored password. Generated by install.sh. If you lose it,
# stored credentials can't be decrypted (re-enter them in the bot).
SECRET_KEY=

# Timezone used for schedules and the Jalali folder dates.
TIMEZONE=Asia/Tehran

# Where the database, logs, Telegram session and temp files live.
DATA_DIR=./data

# Scratch space for zips before they're archived/uploaded. Needs room for
# the biggest day's worth of zips. Defaults to DATA_DIR/staging.
STAGING_DIR=

# Optional proxy for reaching Telegram, e.g.
#   socks5://user:pass@10.0.0.5:1080
#   http://10.0.0.5:3128
#   mtproxy://SECRET@proxy.example.com:443
TG_PROXY=

LOG_LEVEL=INFO
